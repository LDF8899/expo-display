HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=https://expo.example.com
SESSION_COOKIE_SECURE=1
TRUST_PROXY_HEADERS=1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ALLOW_DEFAULT_ADMIN_PASSWORD=0
CSRF_SECRET=REPLACE_WITH_RANDOM_CSRF_SECRET
PASSWORD_MIN_LENGTH=10
ALLOW_WEAK_USER_PASSWORDS=0
ALLOWED_ORIGINS=

DATABASE_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=expo_user
MYSQL_PASSWORD=REPLACE_WITH_DB_PASSWORD
MYSQL_DATABASE=expo_display
MYSQL_SCHEMA_PATH=database/mysql_schema.sql

MAX_JSON_BYTES=8388608
MAX_UPLOAD_BYTES=5242880
ALLOW_SVG_UPLOADS=0
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300
UPLOAD_RATE_LIMIT=120
UPLOAD_RATE_WINDOW_SECONDS=3600

ASSET_STORAGE_BACKEND=s3
ASSET_KEY_PREFIX=uploads
S3_BUCKET=expo-display-assets
S3_ENDPOINT_URL=https://s3.example.com
S3_REGION=auto
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_PUBLIC_BASE_URL=https://cdn.example.com/expo-display-assets
S3_ACL=
